# Проще запустить ./deploy.sh — он сам спросит всё и запишет .env.
# Вручную: скопируйте в .env и заполните. Файл .env в git не попадает.
# Значения со спецсимволами берите в двойные кавычки, а \ " и $ внутри экранируйте: \\ \" \$

# Вход в Unity. Нужен обычный пароль Unity ID: вход через Google на сервере не работает.
UNITY_EMAIL=
UNITY_PASSWORD=

# Telegram-бот для сообщений: создайте его у @BotFather и вставьте токен.
# Номер чата можно не заполнять: напишите боту любое сообщение, и он запомнит чат сам.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сводка от бота: раз в период, даже если ничего не добавлено, — чтобы было видно, что
# служба жива и что видела в каналах. 1d (по умолчанию), 12h, off — не присылать.
BOT_DIGEST=1d

# Тихие часы бота (время службы, TZ): сообщения, которые могут подождать до утра («Fab ждёт вас»), приходят без звука.
# 23-8 по умолчанию; off — всегда со звуком.
BOT_QUIET_HOURS=23-8

# Каталог всех ассетов аккаунта (для ИИ-агента и страница для просмотра): data/profiles/<профиль>/catalog.
# Как часто сверять его со списком «My Assets»: 7d (по умолчанию), 1d, off — только добавленное программой.
CATALOG_REFRESH=7d
# Присылать ли со сводкой бота страницу каталога файлом, когда она изменилась: on (по умолчанию), off.
BOT_CATALOG=on

# Каналы, добавленные только на этом сервере, через запятую. Общий список лежит в telegram_sources.txt
# (он в git, один для всех машин) и читается всегда; здесь — то, чего в нём нет.
TELEGRAM_CHANNELS=

# Как часто проверять каналы: 30m, 6h, 1d.
WATCH_INTERVAL=24h

# Что читать, кроме каналов:
#   telegram — только Telegram-каналы (быстро, так и было раньше);
#   top-free — ещё страница «топ бесплатных» магазина;
#   all      — ещё китайский архив и расширенные списки. Первый проход долгий
#              (больше двухсот ссылок), дальше уже добавленные пропускаются по памяти профиля.
SOURCES=telegram

# Как часто читать списки магазина («топ бесплатных») при SOURCES=top-free или all. Каналы читаются в каждом
# прогоне, списки магазина меняются медленно и требуют браузера, поэтому реже: 3d (по умолчанию), 1d, 12h;
# off — в каждом прогоне.
TOP_FREE_EVERY=3d

# Fab (fab.com, аккаунт Epic Games) на сервере: on — после каждого прогона Unity брать новые ассеты Fab
# из каналов (нужен вход в Epic: команда в конце вывода deploy.sh), off — не трогать. Раздачи −100 % забираете вы.
FAB=off

# Fab: окно браузера для входа и галочки Cloudflare показывается
# в вашем браузере по SSH-туннелю. Пароль окна — 8 знаков (дольше VNC не читает); deploy.sh
# создаёт его сам. Без пароля окно не открывается.
FAB_VNC_PASSWORD=
# Порт окна на самом сервере (слушает только 127.0.0.1): ssh -L 127.0.0.1:6085:127.0.0.1:6085 <сервер>
FAB_VNC_PORT=6085
# Окно для человека: 640x900 — узкое, удобно и с телефона; full — весь экран 1280x900.
FAB_VNC_SIZE=640x900
# Пароль окна в ссылке из сообщения бота (после #, по сети не уходит): on — не вводить руками; off — вводить.
FAB_VNC_LINK_PASSWORD=on
# Окно с телефона без туннеля (кнопка «📱 С телефона», /phone): off; http — по адресу сервера, без шифрования (только
# галочка); https — через домен с сертификатом Let's Encrypt. Всё это настраивает ./deploy.sh (раздел 6б).
FAB_PHONE_LINK=off
FAB_PHONE_HOST=
FAB_PHONE_PORT=7443
# Наружу порт открывается только при включённой ссылке (0.0.0.0), иначе — только localhost.
FAB_PHONE_BIND=127.0.0.1
# Папки сертификата домена (/etc/letsencrypt/live/<домен>, /etc/letsencrypt/archive/<домен>) — пишет deploy.sh.
FAB_PHONE_CERT_LIVE=
FAB_PHONE_CERT_ARCHIVE=

# Сторож прогона: если служба занята, а в лог столько минут не пишется ни строки, прогон считается зависшим —
# служба записывает, что успела, и перезапускается (её поднимает Docker). 45 по умолчанию (Fab ждёт человека до 30 мин);
# от 10 до 1440; 0 — выключить.
RUN_STALL_MINUTES=45

# Имя профиля (папка в data/profiles) и часовой пояс для логов.
PROFILE=server
TZ=Europe/Moscow
